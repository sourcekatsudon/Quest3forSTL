<style>
.root{width:50;padding-top:2;padding-bottom:2;padding-left:2;padding-right:2;flex-direction:column;gap:1;background-color:#f8fafb;border-radius:1.5;}
.row{flex-direction:row;gap:1;}
.actions{flex-direction:row;gap:1;}
.btn{width:46;height:5;background-color:#e5f2f4;border-radius:1;justify-content:center;align-items:center;}
.item{width:22.5;height:18;flex-direction:column;gap:.5;background-color:#edf1f2;border-radius:1;justify-content:center;align-items:center;}
.label{width:46;height:3;}
</style>
<div class="root">
<img id="LibraryTitle" class="label" src="/ui/labels/library.png" />
<img id="LibraryStatus" class="label" src="/ui/labels/loading.png" />
<img id="DragHint" class="label" src="/ui/labels/title.png" />
<div class="actions"><button id="Add" class="btn" style="width:22.5"><img id="AddLabel" class="label" src="/ui/labels/add.png" style="width:21" /></button><button id="Refresh" class="btn" style="width:22.5"><img id="RefreshLabel" class="label" src="/ui/labels/loading.png" style="width:21" /></button></div>
<div class="row"><button id="Item0" class="item"><img id="Thumb0" src="/ui/placeholder.svg" style="width:21;height:13" /><img id="Name0" src="/ui/labels/loading.png" style="width:21;height:2.5" /></button><button id="Item1" class="item"><img id="Thumb1" src="/ui/placeholder.svg" style="width:21;height:13" /><img id="Name1" src="/ui/labels/loading.png" style="width:21;height:2.5" /></button></div><div class="row"><button id="Item2" class="item"><img id="Thumb2" src="/ui/placeholder.svg" style="width:21;height:13" /><img id="Name2" src="/ui/labels/loading.png" style="width:21;height:2.5" /></button><button id="Item3" class="item"><img id="Thumb3" src="/ui/placeholder.svg" style="width:21;height:13" /><img id="Name3" src="/ui/labels/loading.png" style="width:21;height:2.5" /></button></div><div class="row"><button id="Item4" class="item"><img id="Thumb4" src="/ui/placeholder.svg" style="width:21;height:13" /><img id="Name4" src="/ui/labels/loading.png" style="width:21;height:2.5" /></button><button id="Item5" class="item"><img id="Thumb5" src="/ui/placeholder.svg" style="width:21;height:13" /><img id="Name5" src="/ui/labels/loading.png" style="width:21;height:2.5" /></button></div>
<div class="row"><button id="Previous" class="btn" style="width:22.5"><img id="PreviousLabel" class="label" src="/ui/labels/previous.png" style="width:21" /></button><button id="Next" class="btn" style="width:22.5"><img id="NextLabel" class="label" src="/ui/labels/next.png" style="width:21" /></button></div>
</div>
